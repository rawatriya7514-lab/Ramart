# ==============================================================================
# RAMART E-COMMERCE PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your production credentials.
# ==============================================================================

# Server Network Configuration
PORT=8080
BIND_ADDRESS=127.0.0.1
NODE_ENV=production

# Store Owner Configuration
STORE_OWNER_EMAIL=owner@ramart.in

# SMTP Email Notification Credentials (Optional - configured via Admin UI or .env)
# For Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RAMART Store <noreply@ramart.in>"
SMTP_SECURE=tls

# Razorpay Payment Gateway Configuration (Placeholder for production gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# UPI Merchant Configuration
UPI_VPA=ramart@upi
UPI_MERCHANT_NAME=RAMART Online Retail India
